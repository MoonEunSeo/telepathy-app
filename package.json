{
  "name": "telepathy-app",
  "version": "1.0.0",
  "description": "Express + Vite integrated server",
  "main": "server/index.ts",
  "scripts": {
    "start": "tsx --tsconfig server/tsconfig.json server/index.ts",
    "dev": "tsx watch --tsconfig server/tsconfig.json server/index.ts",
    "build": "npm install --prefix telepathy-front && npm run build --prefix telepathy-front",
    "typecheck": "tsc --noEmit -p server/tsconfig.json",
    "format": "prettier --write \"server/**/*.{ts,js,json}\" \"shared/**/*.{ts,js,json}\"",
    "format:check": "prettier --check \"server/**/*.{ts,js,json}\" \"shared/**/*.{ts,js,json}\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "axios": "^1.9.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.1",
    "socket.io": "^4.7.5",
    "solapi": "^5.4.0",
    "tsx": "^4.23.1",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.9.5",
    "typescript": "^7.0.2"
  }
}
