{
  "name": "telepathy-app",
  "version": "1.0.0",
  "description": "관심 단어 기반 실시간 익명 채팅 서비스",
  "main": "server/index.ts",
  "scripts": {
    "start": "tsx --tsconfig server/tsconfig.json server/index.ts",
    "dev": "npm run dev:server",
    "dev:server": "tsx watch --tsconfig server/tsconfig.json server/index.ts",
    "dev:front": "npm run dev --prefix telepathy-front",
    "setup": "npm ci && npm ci --prefix telepathy-front",
    "build": "npm run build --prefix telepathy-front",
    "typecheck": "npm run typecheck:server && npm run typecheck:front",
    "typecheck:server": "tsc --noEmit -p server/tsconfig.json",
    "typecheck:front": "tsc --noEmit -p telepathy-front/tsconfig.app.json",
    "lint": "oxlint -c .oxlintrc.json server shared telepathy-front/src",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"server/**/*.{ts,js,json}\" \"shared/**/*.{ts,js,json}\" \"*.{md,json,mjs,mts,ts}\" \".github/**/*.{md,yml,yaml}\" && npm run format --prefix telepathy-front",
    "format:check": "prettier --check \"server/**/*.{ts,js,json}\" \"shared/**/*.{ts,js,json}\" \"*.{md,json,mjs,mts,ts}\" \".github/**/*.{md,yml,yaml}\" && npm run format:check --prefix telepathy-front",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "axios": "^1.9.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.1",
    "socket.io": "^4.8.3",
    "solapi": "^5.4.0",
    "tsx": "^4.23.1",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11 <12"
  }
}
