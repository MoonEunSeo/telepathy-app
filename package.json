{
  "name": "telepathy-app",
  "version": "1.0.0",
  "description": "Express + Vite integrated server",
  "main": "server/index.ts",
  "scripts": {
    "start": "tsx server/index.ts",
    "dev": "tsx watch server/index.ts",
    "build": "npm install --prefix client && npm run build --prefix client",
    "typecheck": "tsc --noEmit -p server/tsconfig.json"
  },
  "dependencies": {
    "@portone/server-sdk": "^0.14.0",
    "@supabase/supabase-js": "^2.49.4",
    "axios": "^1.9.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.1",
    "socket.io": "^4.7.5",
    "solapi": "^5.4.0",
    "tsx": "^4.23.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.10",
    "typescript": "^7.0.2"
  }
