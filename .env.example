# 실행 환경
NODE_ENV=development
PORT=5000
REALSITE=http://localhost:5000

# 인증·암호화 — 개발 환경에서도 충분히 긴 임의 문자열 사용
JWT_SECRET=
ACCOUNT_SECRET_KEY=
IP_HASH_SECRET=

# Supabase 서버 전용 자격 증명
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 입금 웹훅
WEBHOOK_SECRET=

# SMS
SMS_DRIVER=mock
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SENDER_PHONE=

# 기능 플래그
V2_MATCHING_ENABLED=false

# 수동 검증 스크립트용 테스트 계정
V2_TEST_USERNAME=
V2_TEST_PASSWORD=
